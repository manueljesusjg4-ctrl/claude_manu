# Configuración del servidor. La app usa PostgreSQL (antes SQLite) para poder
# desplegarse en Vercel sin perder datos entre actualizaciones. Crea una base
# de datos gratuita en https://neon.tech o https://supabase.com y pega aquí su
# cadena de conexión (la misma sirve para desarrollo local y para Vercel).
DATABASE_URL="postgresql://usuario:contrasena@host/basededatos?sslmode=require"
JWT_SECRET="cambia-este-secreto-en-tu-ordenador-si-quieres"
PORT=3001

# Opcional: solo en producción (Vercel), para que los documentos/firmas
# subidos no se pierdan al ser el disco del servidor temporal. Se obtiene al
# crear un "Blob Store" en el panel de Vercel (Storage > Blob).
# BLOB_READ_WRITE_TOKEN=
